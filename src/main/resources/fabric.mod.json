{
	"schemaVersion": 1,
	"id": "crimsonclient",
	"version": "${version}",
	"name": "Crimson Client",
	"description": "Beautiful red glass-style PvP client with visuals, utilities and optimization. No cheats.",
	"authors": [
		"Crimson"
	],
	"contact": {},
	"license": "CC0-1.0",
	"icon": "assets/crimsonclient/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"ru.crimson.client.CrimsonClient"
		],
		"client": [
			"ru.crimson.client.CrimsonClientClient"
		]
	},
	"mixins": [
		"crimsonclient.mixins.json",
		{
			"config": "crimsonclient.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
